# GitLink Agent Configuration Template
# Copy this file to .env and adjust variables as needed

# Agent Identification
AGENT_NAME=gitlink_talent_agent
AGENT_SEED=gitlink-developer-talent-and-opportunity-agent-seed-2026

# Network Port (for local execution)
AGENT_PORT=8001

# Agentverse Mailbox Configuration (Optional, for remote discoverability via ASI:One)
# Obtain your Mailbox API Key from https://agentverse.ai -> Agents -> Mailroom
# AGENTVERSE_MAILBOX_KEY=your-agentverse-mailbox-key-here

# GitHub Token (Optional: Increases GitHub API rate limit from 60 to 5000 requests/hour)
# GITHUB_TOKEN=ghp_your_personal_access_token
